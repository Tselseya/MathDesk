# Current local n8n workflow endpoint.
VITE_N8N_WEBHOOK_URL=https://your-current-n8n-host/webhook/mathdesk-ai

# Future hosted API gateway. Takes precedence over the n8n endpoint when set.
# VITE_MATHDESK_API_URL=https://api.example.com

# Supabase project settings for optional login and cross-device history.
# The anon key is safe for browser use when Supabase RLS is configured correctly.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
