# Response headers. GitHub Pages ignores this file (it cannot send custom headers), so on the current host it does nothing.
# Netlify and Cloudflare Pages read it, so keeping it in the repo makes a later move to either host a one-step change.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
