{
  "name": "mathdesk-redesign",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify-build": "node scripts/verify-build.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "test:e2e:auth": "playwright test e2e/auth.spec.ts",
    "test:e2e:auth:headed": "E2E_HEADLESS=false playwright test e2e/auth.spec.ts"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.6.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
